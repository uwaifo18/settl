# Settl — environment variables
# Copy to .env and fill in your values. Never commit .env.

# ── Contract ──────────────────────────────────────────────────────────────────
VITE_ROUTER_ADDRESS=0x6216af3fb64d039b87088f78da38bd641d62b426

# ── Privy (wallet connection on the pay page) ──────────────────────────────
VITE_PRIVY_APP_ID=

# ── Circle Modular Wallets (passkey wallet for merchants) ─────────────────
VITE_CLIENT_KEY=
VITE_CLIENT_URL=https://modular-sdk.circle.com/v1/rpc/w3s/buidl

# ── WalletConnect (optional) ────────────────────────────────────────────────
VITE_WALLETCONNECT_PROJECT_ID=

# ── Network selection ─────────────────────────────────────────────────────────
# Set to "mainnet" for production, "testnet" (default) for development.
VITE_NETWORK=testnet

# ── Mainnet router address (required when VITE_NETWORK=mainnet) ───────────────
# The SettlRouter deployed on Arc Mainnet (chain ID 5042).
# Must be a valid 0x address. If missing on mainnet, payments are blocked.
VITE_MAINNET_ROUTER_ADDRESS=

# ── Mainnet RPC endpoints (optional — defaults are used when unset) ──────────
# Only override if you use a private/partner RPC endpoint.
# Do NOT derive the WS URL from the HTTP URL by string replacement.
VITE_ARC_MAINNET_RPC_URL=
VITE_ARC_MAINNET_WS_URL=

# Optional fallback HTTP RPC for Arc Mainnet (e.g. Blockdaemon, dRPC, QuickNode).
# Only set this if you have a domain-restricted endpoint. Never put a paid key here
# without restricting it to your deployed domain first.
VITE_ARC_MAINNET_RPC_URL_FALLBACK=

# ── Invoice cap (optional) ────────────────────────────────────────────────────
# Maximum USDC value of a single invoice. Defaults: 50 on mainnet, 1000 on testnet.
# Set VITE_MAX_INVOICE_USDC=0.01 for a $0.01 smoke-test cap before go-live.
VITE_MAX_INVOICE_USDC=

# ── Mainnet passkey wallets (disabled by default) ─────────────────────────────
# See DECISIONS.md D9 before enabling. Only set after owner verifies Circle's
# Arc Mainnet endpoint and address determinism.
VITE_PASSKEY_MAINNET_ENABLED=
